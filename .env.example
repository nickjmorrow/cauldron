# Copy to .env.local (gitignored). Next.js loads it for `npm run dev`, `npm run build` and `npm start`.
# `npm run import` is plain Node and does not read it: pass variables on the command line instead.

# USDA FoodData Central API key, used to look up ingredient nutrients.
# Free from https://fdc.nal.usda.gov/api-key-signup. Unset falls back to DEMO_KEY (heavily rate-limited).
USDA_API_KEY=your-usda-api-key

# SQLite database path. Default: data/cauldron.db
CAULDRON_DB=data/cauldron.db

# Spreadsheet that `npm run import` reads when no path is given. Default: data/diet.xlsx
CAULDRON_XLSX=data/diet.xlsx
