# Copy to .env (gitignored), fill in, then run ./generate.sh

# Where the Cauldron server is reached from the phone. The app's settings sheet can override it.
CAULDRON_URL=https://cauldron.example.com

# Apple developer team ID (10 characters), needed to install on a real iPhone and Watch. Empty is fine for simulators.
DEVELOPMENT_TEAM=

# Reverse-DNS prefix for the bundle IDs: <prefix>.cauldron and <prefix>.cauldron.watchkitapp
BUNDLE_PREFIX=com.example
